# Supabase project URL (local: http://127.0.0.1:54321)
# Android emulator: http://10.0.2.2:54321 (10.0.2.2 is the Mac) · physical phone: http://<your-LAN-IP>:54321
# `supabase status` prints the local URL and the publishable key.
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Never the secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stripe publishable key in test mode (pk_test_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Merchant name shown by the PaymentSheet
EXPO_PUBLIC_MERCHANT_DISPLAY_NAME=Vitrina
# If "true", the app starts directly in demo mode (useful for recording GIFs and for Maestro)
EXPO_PUBLIC_FORCE_DEMO=false
